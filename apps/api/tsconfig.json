{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    // Editor/typecheck config: resolve the workspace packages from their
    // TypeScript source, so `tsc --noEmit` works before anything is built.
    // `tsconfig.build.json` clears these paths and narrows `rootDir` to ./src.
    "rootDir": "../..",
    "noEmit": true,
    "paths": {
      "@heddlio/auth": ["../../packages/auth/src/index.ts"],
      "@heddlio/db": ["../../packages/db/src/index.ts"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}
