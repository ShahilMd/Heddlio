# Copy to .env and replace the placeholder values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=heddlio

# Must match the POSTGRES_* values above and the port mapped in docker-compose.yml.
DATABASE_URL=postgresql://postgres:change-me@localhost:5442/heddlio

# Authorization / invitations. See AUTHORIZATION.md.
# dev-header is a development-only identity provider; production must plug a
# real authentication driver into IdentityProvider before starting the API.
AUTH_DRIVER=dev-header
WEB_APP_URL=http://localhost:3000
INVITATION_TTL_DAYS=7
MAIL_TRANSPORT=console
MAIL_FROM=Heddlio <no-reply@heddlio.local>
SYNC_PERMISSION_CATALOG=true
