{
  "name": "heddlio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @heddlio/auth build && pnpm --filter @heddlio/db build",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "backend": "pnpm --filter api start:dev",
    "web": "pnpm --filter web dev",
    "admin": "pnpm --filter admin dev"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@heddlio/config": "workspace:*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "varlock": "1.23.0"
  },
  "packageManager": "pnpm@12.18.0"
}
